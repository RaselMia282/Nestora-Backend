<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Reset OTP</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background-color: #f8fafc; color: #1e293b;">

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f8fafc; padding: 40px 10px;">
    <tr>
      <td align="center">
        <!-- Main Card -->
        <table role="presentation" width="100%" style="max-width: 480px; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); padding: 40px; border: 1px solid #e2e8f0;">
          
          <!-- Header Icon -->
          <tr>
            <td align="center" style="padding-bottom: 20px;">
              <div style="width: 56px; height: 56px; background-color: #eff6ff; border-radius: 50%; line-height: 56px; text-align: center; font-size: 26px;">
                🔐
              </div>
            </td>
          </tr>

          <!-- Heading & Greeting -->
          <tr>
            <td align="center">
              <h2 style="margin: 0; font-size: 22px; font-weight: 700; color: #0f172a;">Password Reset Request</h2>
              <p style="margin-top: 10px; margin-bottom: 24px; font-size: 15px; color: #475569; line-height: 1.5;">
                Hello <strong><%= name %></strong>,<br>
                We received a request to reset your password. Use the verification code below to complete the process.
              </p>
            </td>
          </tr>

          <!-- 6-Digit OTP Box Grid -->
          <tr>
            <td align="center" style="padding: 10px 0 25px 0;">
              <table role="presentation" cellspacing="0" cellpadding="0">
                <tr>
                  <% otp.split('').forEach(function(digit) { %>
                    <td style="padding: 0 4px;">
                      <div style="
                        width: 42px;
                        height: 50px;
                        line-height: 50px;
                        text-align: center;
                        font-size: 24px;
                        font-weight: 700;
                        color: #2563eb;
                        background-color: #f1f5f9;
                        border: 1px solid #cbd5e1;
                        border-radius: 8px;
                      ">
                        <%= digit %>
                      </div>
                    </td>
                  <% }); %>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Expiration Notice -->
          <tr>
            <td align="center">
              <p style="margin: 0; font-size: 13px; color: #dc2626; font-weight: 600;">
                ⏰ This code will expire in <strong><%= expirationMinutes %> minutes</strong>.
              </p>
              <p style="margin-top: 12px; margin-bottom: 0; font-size: 12px; color: #94a3b8; line-height: 1.4;">
                If you didn't request a password reset, you can safely ignore this email.
              </p>
            </td>
          </tr>

          <!-- Footer Divider -->
          <tr>
            <td style="padding-top: 30px;">
              <hr style="border: none; border-top: 1px solid #f1f5f9; margin: 0;">
            </td>
          </tr>

          <!-- Footer Text -->
          <tr>
            <td align="center" style="padding-top: 20px;">
              <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                &copy; <%= new Date().getFullYear() %> Nestora. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>