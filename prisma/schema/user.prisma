model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  passwordHash String?
  role         Role         @default(TENANT)
  authProvider AuthProvider @default(CREDENTIAL)
  googleId     String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  profile      Profile?
  properties   Property[]
  applications Application[]
  payments     Payment[]

  @@map("users")
}
