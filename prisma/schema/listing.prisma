model Listing {
  id          String   @id @default(uuid())
  roomId      String   @unique
  title       String
  description String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("listings")
}